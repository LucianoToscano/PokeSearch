{
  "rules": {
    ".read": false,
    ".write": false,
    "stats": {
      "installations": {
        ".read": false,
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['installedAt'])",
          "installedAt": {
            ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          },
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "online": {
        ".read": false,
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['connectedAt'])",
          "connectedAt": {
            ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          },
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "public": {
        ".read": "auth != null",
        ".write": false,
        "installCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "onlineCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "scrapbook": {
      "config": {
        "allowDirectPosts": {
          ".read": "auth != null",
          ".write": false,
          ".validate": "newData.isBoolean()"
        }
      },
      "posts": {
        ".read": "auth != null",
        "$postId": {
          ".write": false,
          ".validate": "newData.hasChildren(['authorUid','nickname','category','text','createdAt','status','pinned'])",
          "authorUid": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "nickname": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 24"
          },
          "category": {
            ".validate": "newData.isString() && newData.val().matches(/^(recados|sugestoes|bugs|dicas)$/)"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 300"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 60000"
          },
          "status": {
            ".validate": "newData.val() === 'published'"
          },
          "pinned": {
            ".validate": "newData.val() === false"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "likes": {
        ".read": "auth != null",
        "$postId": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.val() === true && root.child('scrapbook/posts').child($postId).child('status').val() === 'published'",
            ".validate": "newData.isBoolean() && newData.val() === true"
          }
        }
      },
      "replies": {
        ".read": "auth != null",
        "$postId": {
          "$replyId": {
            ".write": false,
            ".validate": "newData.hasChildren(['authorUid','nickname','text','createdAt'])",
            "authorUid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "nickname": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 24"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 200"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 60000"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "reports": {
        "$postId": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && root.child('scrapbook/posts').child($postId).child('status').val() === 'published'",
            ".validate": "newData.hasChildren(['reason','createdAt'])",
            "reason": {
              ".validate": "newData.val() === 'inappropriate'"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 60000"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "chat": {
      ".read": false,
      ".write": false,
      "messages": {
        ".indexOn": [
          "createdAt"
        ],
        ".read": "auth != null && query.orderByChild === 'createdAt' && query.limitToLast !== null && query.limitToLast <= 60",
        "$messageId": {
          ".write": "(auth != null && !data.exists() && newData.exists() && newData.child('authorUid').val() === auth.uid) || (auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.token.email_verified === true && auth.token.email === 'lucianotoscano@gmail.com' && data.exists() && !newData.exists())",
          ".validate": "newData.hasChildren(['authorUid','nickname','text','createdAt'])",
          "authorUid": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "nickname": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 24"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 240"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          }
        },
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.token.email_verified === true && auth.token.email === 'lucianotoscano@gmail.com' && data.exists() && !newData.exists()"
      },
      "avatars": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (newData.exists() || data.exists())",
          ".validate": "newData.isString() && newData.val().length <= 24000 && newData.val().beginsWith('data:image/jpeg;base64,')"
        }
      }
    }
  }
}
